# ── Profile ────────────────────────────────────────────────────────────────
# local  = scikit-learn engine, background Adaption poller, large imports
# cloud  = pure-Python engine, browser-driven Adaption sync, free-tier limits
APP_PROFILE=local

# ── Database ───────────────────────────────────────────────────────────────
# Leave unset for a zero-setup SQLite file at apps/api/data/insightflow.db.
# Postgres (docker compose or Neon):
# DATABASE_URL=postgresql://insightflow:insightflow@localhost:5432/insightflow

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
# Allow Vercel preview deployments as well:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Adaption (https://docs.adaptionlabs.ai) ────────────────────────────────
# Create under Settings → API keys in the Adaption app. Optional: without it
# the app uses the built-in engine and the manual export/import path.
ADAPTION_API_KEY=

# ── Optional overrides of the profile defaults ─────────────────────────────
# ANALYSIS_ENGINE=auto        # auto | sklearn | lite
# MAX_IMPORT_ROWS=250000
# MAX_UPLOAD_MB=50
# BACKGROUND_SYNC=true
# AUTO_SEED=true              # load the sample dataset into an empty database
# ADAPTION_SAMPLE_SNAPSHOT=true   # restore the saved Adaption output when the sample is loaded
# ADAPTION_AUTO_ENRICH=true        # send new feedback to Adaption automatically
# ADAPTION_AUTO_MAX_CREDITS=2      # per run; a dearer run waits for a click on the Adaption page
# ADAPTION_AUTO_DAILY_RUNS=10      # automatic runs allowed per 24 hours
